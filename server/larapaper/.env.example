# Copy to server/larapaper/.env (gitignored, chmod 600). Read by docker compose and by
# scripts/push-template.sh.

# Laravel encryption key. Generate with:  echo "base64:$(openssl rand -base64 32)"
# Keep it stable once data exists (it encrypts stored secrets). When moving to the VPS, copy the
# laptop's value.
APP_KEY=base64:REPLACE_ME

# Base URL the NOTE4C uses to download rendered images. No trailing slash.
#   LAN:  http://<laptop-lan-ip>:4567   (not localhost)
#   VPS:  https://<PUBLIC_HOST>
APP_URL=http://192.168.1.10:4567

# uuid of the dashboard webhook plugin (Plugins -> dashboard -> webhook URL). Used by
# scripts/push-template.sh. Secret: anyone with it (and the token) can write to the screen.
DASHBOARD_PLUGIN_UUID=

# ---- VPS only (compose.prod.yml + Caddyfile) -------------------------------------
# Makes plain `docker compose ...` (and push-template.sh) use the production file.
COMPOSE_FILE=compose.prod.yml
# Public hostname of the Cloudflare Tunnel, e.g. paper.example.com
PUBLIC_HOST=paper.example.com
# Required on webhook calls (Authorization: Bearer ...). Generate with: openssl rand -hex 32
WEBHOOK_TOKEN=
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> the token in the install command
TUNNEL_TOKEN=

# ---- VPS collector: weather + GitHub (service "collector", timer in host/vps/) -----
# Two decimals (~1 km) is plenty for a forecast; don't use your exact address.
LAT=
LON=
TZ=America/New_York
WEATHER_UNIT=celsius
# github.com username whose public contribution graph is shown
GH_USERNAME=
# Optional: GH_WEEKS=18, HEATMAP_STYLE=stripes
