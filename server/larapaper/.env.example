# Copy to server/larapaper/.env (gitignored). Read by docker compose (app + caddy) and by
# scripts/push-template.sh.

# Laravel encryption key. Generate with:  echo "base64:$(openssl rand -base64 32)"
# Keep it stable once data exists (it encrypts stored secrets).
APP_KEY=base64:REPLACE_ME

# Base URL the NOTE4C uses to download rendered images. No trailing slash.
#   LAN:  http://<laptop-lan-ip>:4567   (not localhost)
#   VPS:  https://<PUBLIC_HOST>
APP_URL=http://192.168.1.10:4567

# uuid of the dashboard webhook plugin (Plugins -> dashboard -> webhook URL). Used by
# scripts/push-template.sh. Secret: anyone with it can write to the screen.
DASHBOARD_PLUGIN_UUID=

# ---- VPS only (compose.prod.yml + Caddyfile) -------------------------------------
PUBLIC_HOST=eink.example.com
ADMIN_HOST=vps-name.tailnet-name.ts.net
TAILSCALE_IP=100.64.0.1
# openssl rand -hex 32
WEBHOOK_TOKEN=
ACME_EMAIL=you@example.com
