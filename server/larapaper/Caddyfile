# Caddy behind Cloudflare Tunnel on the VPS (compose.prod.yml). See docs/deploy-vps.md.
#
#   device / senders ─HTTPS─> Cloudflare ─tunnel─> cloudflared ─HTTP─> caddy:80 ─> larapaper:8080
#
# TLS ends at Cloudflare, so Caddy serves plain HTTP on the private compose network and publishes
# no ports. Its job is the allow-list: the internet only reaches the device API, the rendered
# images and the token-checked webhook. The admin UI goes over Tailscale (`tailscale serve`).
#
# Values come from server/larapaper/.env (passed in by compose.prod.yml):
#   PUBLIC_HOST    e.g. paper.example.com   the tunnel's public hostname
#   WEBHOOK_TOKEN  long random string, also LARAPAPER_WEBHOOK_TOKEN for the collector
{
	auto_https off
	admin off # nothing reloads Caddy over its API; restart the container to apply changes

	servers {
		# Requests only come from cloudflared on the private Docker network. Trusting it keeps the
		# X-Forwarded-Proto: https it sends (LaraPaper builds https:// links) and the visitor's IP.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip
	}
}

http://{$PUBLIC_HOST} {
	# Device API (each request carries the device's access-token, checked by LaraPaper)
	# and the rendered screens it downloads (random file names).
	@device path /api/setup /api/display /api/log /api/current_screen /storage/images/*
	handle @device {
		reverse_proxy larapaper:8080
	}

	# Webhook: the plugin uuid in the URL is not enough on the internet; also require the token.
	@webhook path /api/custom_plugins/*
	handle @webhook {
		@authorized header Authorization "Bearer {$WEBHOOK_TOKEN}"
		handle @authorized {
			request_header -Authorization
			reverse_proxy larapaper:8080
		}
		respond 401
	}

	# Everything else (login, settings, the rest of the API) does not exist publicly.
	handle {
		respond 404
	}

	log
}

# Any other Host header (e.g. another hostname routed to this tunnel by mistake).
http:// {
	respond 404
}
