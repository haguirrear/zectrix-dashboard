# Copy to collector/.env (gitignored) and fill in. In GitHub Actions the same names come from
# repository secrets/variables instead (see .github/workflows/collect.yml).

# ---- Sink (where the data goes) ----------------------------------------------
SINK=larapaper
# LaraPaper webhook plugin URL: Plugins -> your plugin -> webhook URL.
# Shape: https://<server>/api/custom_plugins/<plugin-uuid>. Treat it as a secret: anyone with
# the uuid can write to your screen.
LARAPAPER_WEBHOOK_URL=
# Bearer token checked by the Caddy proxy in front of a public LaraPaper (server/larapaper/Caddyfile).
# Leave empty for a LAN-only LaraPaper.
LARAPAPER_WEBHOOK_TOKEN=

# ---- Weather (Open-Meteo, no key) ----------------------------------------------
# Two decimals (~1 km) is plenty for a forecast; don't use your exact address.
LAT=
LON=
TZ=America/New_York
WEATHER_UNIT=celsius

# ---- GitHub contributions -------------------------------------------------------
# Your github.com username. The graph comes from your public profile page, so no token is needed.
GH_USERNAME=
GH_WEEKS=18
# Heatmap fill: "stripes" (diagonal hatching) or "dither" (25/50/75% ordered dither)
HEATMAP_STYLE=stripes

# ---- Claude Code usage (PC only) -----------------------------------------------
# Snapshot written by host/claude-code/claude_usage_tap.py
CLAUDE_USAGE_FILE=~/.cache/claude-usage.json

# ---- Pet photo (PC only; the photo is never committed) ---------------------------
# FOCUS = crop center as x,y fractions; ZOOM > 1 crops tighter.
PET_PHOTO=
PET_FOCUS=0.5,0.42
PET_ZOOM=1.5
PET_SIZE=140x300
