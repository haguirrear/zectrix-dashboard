root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,liquid,md,sh}]
indent_style = space
indent_size = 2

[Caddyfile]
indent_style = tab

[firmware/trmnl/**]
# upstream code: keep its own style
indent_style = unset
indent_size = unset
